# À copier dans /etc/mon-depute.env, lisible par le seul utilisateur du service
# (chmod 600). Ne jamais enregistrer ce fichier rempli dans le dépôt.

# Clé de signature des liens envoyés par e-mail. À générer une fois :
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# La changer invalide tous les liens déjà envoyés.
MD_SECRET=

# Adresse publique du site. Le service de la lettre est servi sous /api du même domaine.
MD_SITE_URL=https://exemple.fr
MD_API_URL=https://exemple.fr

MD_DONNEES=/srv/mon-depute/donnees/assemblee.sqlite
MD_ABONNES=/srv/mon-depute/donnees/abonnes.sqlite

# Expéditeur : une adresse du domaine vérifié chez le prestataire d'envoi.
MD_EXPEDITEUR=Mon député <lettre@exemple.fr>

# Envoi par SMTP (valeurs à reprendre de la console du prestataire).
MD_SMTP_HOTE=
MD_SMTP_PORT=587
MD_SMTP_UTILISATEUR=
MD_SMTP_MOT_DE_PASSE=

# Le service est derrière Caddy, qui renseigne X-Forwarded-For.
MD_DERRIERE_PROXY=1
