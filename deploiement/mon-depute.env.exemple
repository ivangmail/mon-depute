# À copier dans /etc/mon-depute.env, lisible par le seul utilisateur du service
# (chmod 600). Ne jamais enregistrer ce fichier rempli dans le dépôt.

# Clé de signature des liens envoyés par e-mail. À générer une fois :
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# La changer invalide tous les liens déjà envoyés.
MD_SECRET=

# Adresse publique du site. Le service de la lettre est servi sous /api du même domaine.
MD_SITE_URL=https://exemple.fr
MD_API_URL=https://exemple.fr

# Mentions légales : nom de l'éditeur et adresse de contact publiés sur le site.
# Sans MD_EDITEUR, la page Mentions légales n'est pas générée.
MD_EDITEUR="Prénom Nom"
MD_CONTACT=contact@exemple.fr

MD_DONNEES=/srv/mon-depute/donnees/assemblee.sqlite
MD_ABONNES=/srv/mon-depute/donnees/abonnes.sqlite

# Expéditeur : une adresse du domaine vérifié chez le prestataire d'envoi.
# Les guillemets sont nécessaires : la valeur contient des espaces et des chevrons.
MD_EXPEDITEUR="Mon député <lettre@exemple.fr>"

# Envoi par SMTP (valeurs à reprendre de la console du prestataire).
# Scaleway Transactional Email : hôte smtp.tem.scaleway.com, utilisateur = identifiant
# du projet, mot de passe = clé secrète d'une clé d'API autorisée pour Transactional
# Email. Depuis une Instance Scaleway, les ports 25, 465 et 587 sont bloqués par
# défaut : utiliser 2465, ou cocher « Enable SMTP » dans le groupe de sécurité.
# Ports 465 et 2465 : chiffrement direct. Ports 587 et 2587 : STARTTLS.
MD_SMTP_HOTE=smtp.tem.scaleway.com
MD_SMTP_PORT=2465
MD_SMTP_UTILISATEUR=
MD_SMTP_MOT_DE_PASSE=

# Exemple de lettre publié sur le site (page exemple-lettre.html, liée depuis
# l'accueil) : la lettre hebdomadaire réelle d'une circonscription, au format
# « département-numéro ». Laisser vide pour ne pas publier d'exemple.
MD_EXEMPLE_LETTRE=

# Le service est derrière Caddy, qui renseigne X-Forwarded-For.
MD_DERRIERE_PROXY=1

# Copie chiffrée quotidienne de la base des abonnés hors du serveur (facultatif,
# voir « Sauvegarde » dans deploiement/README.md). Sans MD_S3_ESPACE, seule la
# copie locale est faite.
# Espace de stockage (bucket) Scaleway Object Storage, privé, de préférence dans
# une autre région que le serveur. Région : fr-par, nl-ams ou pl-waw.
MD_S3_ESPACE=
MD_S3_REGION=fr-par
# Clé d'API d'une application IAM limitée à Object Storage : clé d'accès (SCW…)
# et clé secrète.
MD_S3_CLE_ACCES=
MD_S3_CLE_SECRETE=
# Phrase secrète de chiffrement des copies, d'au moins 20 caractères. À générer :
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# À conserver AUSSI hors du serveur (gestionnaire de mots de passe) : sans elle,
# les copies sont illisibles. La changer rend les copies existantes illisibles
# avec la nouvelle phrase.
MD_SAUVEGARDE_PHRASE=
