# Remplacer exemple.fr par le nom de domaine. Caddy obtient et renouvelle
# seul le certificat HTTPS.
exemple.fr {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8766
	}

	handle {
		root * /srv/mon-depute/site
		# Le site est régénéré chaque jour : le navigateur doit demander à chaque
		# visite si la page a changé (réponse « inchangé » sinon, sans la renvoyer).
		header Cache-Control "no-cache"
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
